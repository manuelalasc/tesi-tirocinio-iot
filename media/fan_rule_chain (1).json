        "configuration": {
          "scriptLang": "JS",
          "alarmDetailsBuildJs": "var details = {};\r\n\r\ndetails.humidity = msg.humidity;\r\n\r\n// Contatore \r\nif (metadata.prevAlarmDetails != null) {\r\n  var prevDetails = JSON.parse(metadata.prevAlarmDetails);\r\n  // Se allarme già attivo, incrementa\r\n  details.count = prevDetails.count + 1;\r\n} else {\r\n  // Se è primo avvio, imposta il contatore a 1\r\n  details.count = 1;\r\n}\r\n\r\nreturn details;",
          "alarmDetailsBuildTbel": "var details = {};\nif (metadata.prevAlarmDetails != null) {\n    details = JSON.parse(metadata.prevAlarmDetails);\n    //remove prevAlarmDetails from metadata\n    metadata.remove('prevAlarmDetails');\n    //now metadata is the same as it comes IN this rule node\n}\n\n\nreturn details;",
