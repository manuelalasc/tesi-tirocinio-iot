        "configurationVersion": 0,
        "configuration": {
          "scriptLang": "JS",
          "jsScript": "var t = msg.temperature;\r\nvar h = msg.humidity;\r\nvar dp = msg.dewPoint;\r\nvar links = [];\r\n\r\nif (t > 27.0 || h > 90.0 || (t - dp) <= 2.0) {\r\n    links.push(\"Attivazione_Raffrescamento\");\r\n} else if (h < 60.0) {\r\n    links.push(\"Allarme_Aria_Secca\");\r\n} else {\r\n    links.push(\"Condizioni_Ottimali\");\r\n}\r\n\r\nreturn links;",
          "tbelScript": "function nextRelation(metadata, msg) {\n    return ['one','nine'];\n}\nif(msgType == 'POST_TELEMETRY_REQUEST') {\n    return ['two'];\n}\nreturn nextRelation(metadata, msg);"
        },
        "additionalInfo": {
          "description": "Controllo temperatura, umidità e punto di rugiada per attivazione ventola",
          "layoutX": 874,
          "layoutY": 296
